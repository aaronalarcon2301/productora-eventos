generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(100)
  email     String?  @unique @db.VarChar(120)
  telefono  String?  @db.VarChar(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventos   Evento[]

  @@map("clientes")
}

model Lugar {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique @db.VarChar(100)
  ubicacion String?  @db.VarChar(150)
  capacidad Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventos  Evento[]

  @@map("lugares")
}

model Evento {
  id               Int       @id @default(autoincrement())
  nombre           String    @db.VarChar(100)
  fecha            DateTime
  numInvitados     Int
  presupuesto      Float?
  confirmado       Boolean   @default(false)

  // --- Abono ---
  fechaPago        DateTime?
  montoAbono       Float?

  // --- Cancelación y devolución ---
  cancelado        Boolean   @default(false)
  fechaCancelacion DateTime?
  montoDevolucion  Float?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  clienteId        Int
  cliente          Cliente   @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  lugarId          Int
  lugar            Lugar     @relation(fields: [lugarId], references: [id], onDelete: Restrict)

  reclamos         Reclamo[]
  evaluaciones     Evaluacion[]
  incidentes       Incidente[]

  @@map("eventos")
}

model Reclamo {
  id           Int      @id @default(autoincrement())
  autor        String   @db.VarChar(100)
  calificacion Int
  mensaje      String   @db.Text
  createdAt    DateTime @default(now())

  eventoId     Int
  evento       Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@map("reclamos")
}

enum RolTrabajador {
  TECNICO_SONIDO
  TECNICO_ILUMINACION
  MONTAJISTA
  ANIMADOR
  GARZON
  ANFITRION
  ASEO_LOGISTICA
  SEGURIDAD
}

enum TipoIncidente {
  INASISTENCIA
  FALTA_GRAVE
}

model Trabajador {
  id              Int           @id @default(autoincrement())
  nombre          String        @db.VarChar(100)
  rolPrincipal    RolTrabajador
  bloqueado       Boolean       @default(false)
  promedioGeneral Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  evaluaciones Evaluacion[]
  incidentes   Incidente[]

  @@map("trabajadores")
}


model Evaluacion {
  id Int @id @default(autoincrement())

  trabajadorId Int
  trabajador   Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Restrict)

  eventoId Int
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  rolEvento RolTrabajador

  
  llegada                        Int
  comentarioLlegada               String? @db.Text
  cumplimientoHorarios            Int
  comentarioCumplimientoHorarios  String? @db.Text
  tiemposPreparacion              Int
  comentarioTiemposPreparacion    String? @db.Text
  promedioPuntualidad             Float

  
  comunicacion           Int
  comentarioComunicacion String? @db.Text
  atencion               Int
  comentarioAtencion     String? @db.Text
  conducta               Int
  comentarioConducta     String? @db.Text
  promedioTrato          Float

  
  cumplimiento           Int
  comentarioCumplimiento String? @db.Text
  autonomia              Int
  comentarioAutonomia    String? @db.Text
  resolucion             Int
  comentarioResolucion   String? @db.Text
  promedioEficiencia     Float

  
  usoEquipos                  Int?
  comentarioUsoEquipos        String? @db.Text
  cuidadoEquipos              Int?
  comentarioCuidadoEquipos    String? @db.Text
  resolucionTecnica           Int?
  comentarioResolucionTecnica String? @db.Text
  promedioManejoEquipos       Float?

  promedioEvaluacion Float 
  adminId            Int?

  createdAt DateTime @default(now())

  @@unique([trabajadorId, eventoId]) 
  @@map("evaluaciones")
}

model Incidente {
  id Int @id @default(autoincrement())

  trabajadorId Int
  trabajador   Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Restrict)

  eventoId Int?
  evento   Evento? @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  tipo   TipoIncidente
  motivo String? @db.Text // obligatorio solo si tipo = FALTA_GRAVE (se valida en incidente.schema.js)

  createdAt DateTime @default(now())

  @@map("incidentes")
}
