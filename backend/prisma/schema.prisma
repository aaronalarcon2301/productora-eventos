generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(100)
  rut       String?  @unique @db.VarChar(12)
  email     String?  @unique @db.VarChar(120)
  telefono  String?  @db.VarChar(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventos   Evento[]

  @@map("clientes")
}

model Lugar {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique @db.VarChar(100)
  ubicacion String?  @db.VarChar(150)
  capacidad Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventos  Evento[]

  @@map("lugares")
}

model Evento {
  id               Int       @id @default(autoincrement())
  nombre           String    @db.VarChar(100)
  fecha            DateTime
  numInvitados     Int
  presupuesto      Float?
  confirmado       Boolean   @default(false)

  // --- Abono ---
  fechaPago        DateTime?
  montoAbono       Float?

  // --- Cancelación y devolución ---
  cancelado        Boolean   @default(false)
  fechaCancelacion DateTime?
  montoDevolucion  Float?

  finalizadoAt     DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  clienteId        Int
  cliente          Cliente   @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  lugarId          Int
  lugar            Lugar     @relation(fields: [lugarId], references: [id], onDelete: Restrict)

  reclamos         Reclamo[]
  evaluaciones     Evaluacion[]
  incidentes       Incidente[]
  asignaciones     AsignacionTrabajador[]
  reservasEquipo   ReservaEquipo[]

  @@map("eventos")
}

model Reclamo {
  id           Int      @id @default(autoincrement())
  autor        String   @db.VarChar(100)
  calificacion Int
  mensaje      String   @db.Text
  createdAt    DateTime @default(now())

  eventoId     Int
  evento       Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@map("reclamos")
}

enum RolTrabajador {
  TECNICO_SONIDO
  TECNICO_ILUMINACION
  MONTAJISTA
  ANIMADOR
  GARZON
  ANFITRION
  ASEO_LOGISTICA
  SEGURIDAD
}

enum TipoIncidente {
  INASISTENCIA
  FALTA_GRAVE
}

model Trabajador {
  id              Int           @id @default(autoincrement())
  nombre          String        @db.VarChar(100)
  rolPrincipal    RolTrabajador

  rut             String?       @unique @db.VarChar(12)
  email           String?       @db.VarChar(120)
  telefono        String?       @db.VarChar(20)
  comuna          String?       @db.VarChar(80)

  aniosExperiencia    Int?
  disponibilidadDias  DiaSemana[]       @default([])
  disponibilidadTurno TurnoDisponible?

  tallaUniforme   String?       @db.VarChar(10)
  banco           String?       @db.VarChar(60)
  tipoCuenta      TipoCuenta?
  numeroCuenta    String?       @db.VarChar(30)

  activo          Boolean       @default(true)
  bloqueado       Boolean       @default(false)
  promedioGeneral Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  evaluaciones Evaluacion[]
  incidentes   Incidente[]
  asignaciones AsignacionTrabajador[]
  reservasEquipo ReservaEquipo[]

  @@map("trabajadores")
}

model Evaluacion {
  id Int @id @default(autoincrement())

  trabajadorId Int
  trabajador   Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Restrict)

  eventoId Int
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  rolEvento RolTrabajador

  llegada                        Int
  comentarioLlegada               String? @db.Text
  cumplimientoHorarios            Int
  comentarioCumplimientoHorarios  String? @db.Text
  tiemposPreparacion              Int
  comentarioTiemposPreparacion    String? @db.Text
  promedioPuntualidad             Float

  comunicacion           Int
  comentarioComunicacion String? @db.Text
  atencion               Int
  comentarioAtencion     String? @db.Text
  conducta               Int
  comentarioConducta     String? @db.Text
  promedioTrato          Float

  cumplimiento           Int
  comentarioCumplimiento String? @db.Text
  autonomia              Int
  comentarioAutonomia    String? @db.Text
  resolucion             Int
  comentarioResolucion   String? @db.Text
  promedioEficiencia     Float

  usoEquipos                  Int?
  comentarioUsoEquipos        String? @db.Text
  cuidadoEquipos              Int?
  comentarioCuidadoEquipos    String? @db.Text
  resolucionTecnica           Int?
  comentarioResolucionTecnica String? @db.Text
  promedioManejoEquipos       Float?

  promedioEvaluacion Float 
  adminId            Int?
  modificadoPorId    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([trabajadorId, eventoId]) 
  @@map("evaluaciones")
}

model Incidente {
  id Int @id @default(autoincrement())

  trabajadorId Int
  trabajador   Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Restrict)

  eventoId Int?
  evento   Evento? @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  tipo   TipoIncidente
  motivo String? @db.Text

  createdAt DateTime @default(now())

  @@map("incidentes")
}

model PoliticaDevolucion {
  id          Int   @id @default(autoincrement())
  diasDesde   Int   // Límite inferior del tramo (ej: 0, 6, 16)
  diasHasta   Int?  // Límite superior del tramo (ej: 5, 15, null para infinito)
  porcentaje  Int   // Porcentaje a devolver (ej: 100, 50, 0)
}

model AsignacionTrabajador {
  id Int @id @default(autoincrement())

  trabajadorId Int
  trabajador   Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Restrict)

  eventoId Int
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  rol       RolTrabajador
  createdAt DateTime      @default(now())

  @@unique([trabajadorId, eventoId])
  @@map("asignaciones_trabajador")
}

enum AccionEvaluacion {
  EDITADA
  ELIMINADA
}

model AuditoriaEvaluacion {
  id Int @id @default(autoincrement())

  evaluacionId Int
  trabajadorId Int
  eventoId     Int

  accion          AccionEvaluacion
  motivo          String?          @db.Text
  adminId         Int?
  datosAnteriores Json

  createdAt DateTime @default(now())

  @@index([trabajadorId])
  @@map("auditoria_evaluaciones")
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum TurnoDisponible {
  DIURNO
  NOCTURNO
  AMBOS
}

enum TipoCuenta {
  CORRIENTE
  VISTA
  CUENTA_RUT
  AHORRO
}

enum CategoriaEquipo {
  SONIDO
  ILUMINACION
  AUDIOVISUAL
  MOBILIARIO
  ESTRUCTURA
  OTRO
}

enum EstadoReserva {
  RESERVADO
  ENTREGADO
  DEVUELTO
}

model Equipo {
  id Int @id @default(autoincrement())

  nombre      String          @unique @db.VarChar(100)
  categoria   CategoriaEquipo
  descripcion String?         @db.VarChar(255)

  cantidadTotal      Int
  cantidadMantencion Int @default(0)
  precioArriendoDia  Int?

  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservas ReservaEquipo[]

  @@map("equipos")
}

model ReservaEquipo {
  id Int @id @default(autoincrement())

  equipoId Int
  equipo   Equipo @relation(fields: [equipoId], references: [id], onDelete: Restrict)

  eventoId Int
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  responsableId Int?
  responsable   Trabajador? @relation(fields: [responsableId], references: [id], onDelete: SetNull)

  cantidad Int
  estado   EstadoReserva @default(RESERVADO)

  cantidadDanada   Int     @default(0)
  cantidadFaltante Int     @default(0)
  observacion      String? @db.VarChar(255)

  entregadaAt DateTime?
  devueltaAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([equipoId, eventoId])
  @@map("reservas_equipo")
}
